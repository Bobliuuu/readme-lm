<xsl:template name="mv512"><xsl:param name="M"/><xsl:param name="x"/><xsl:for-each select="$M/r"><v><xsl:call-template name="dot512"><xsl:with-param name="r" select="."/><xsl:with-param name="x1" select="$x[position() &gt; 0 and position() &lt;= 32]"/><xsl:with-param name="x2" select="$x[position() &gt; 32 and position() &lt;= 64]"/><xsl:with-param name="x3" select="$x[position() &gt; 64 and position() &lt;= 96]"/><xsl:with-param name="x4" select="$x[position() &gt; 96 and position() &lt;= 128]"/><xsl:with-param name="x5" select="$x[position() &gt; 128 and position() &lt;= 160]"/><xsl:with-param name="x6" select="$x[position() &gt; 160 and position() &lt;= 192]"/><xsl:with-param name="x7" select="$x[position() &gt; 192 and position() &lt;= 224]"/><xsl:with-param name="x8" select="$x[position() &gt; 224 and position() &lt;= 256]"/><xsl:with-param name="x9" select="$x[position() &gt; 256 and position() &lt;= 288]"/><xsl:with-param name="x10" select="$x[position() &gt; 288 and position() &lt;= 320]"/><xsl:with-param name="x11" select="$x[position() &gt; 320 and position() &lt;= 352]"/><xsl:with-param name="x12" select="$x[position() &gt; 352 and position() &lt;= 384]"/><xsl:with-param name="x13" select="$x[position() &gt; 384 and position() &lt;= 416]"/><xsl:with-param name="x14" select="$x[position() &gt; 416 and position() &lt;= 448]"/><xsl:with-param name="x15" select="$x[position() &gt; 448 and position() &lt;= 480]"/><xsl:with-param name="x16" select="$x[position() &gt; 480 and position() &lt;= 512]"/></xsl:call-template></v></xsl:for-each></xsl:template>

<xsl:template name="matvec"><xsl:param name="M"/><xsl:param name="x"/><xsl:param name="n"/>
  <xsl:choose>
    <xsl:when test="$n=128"><xsl:call-template name="mv128"><xsl:with-param name="M" select="$M"/><xsl:with-param name="x" select="$x"/></xsl:call-template></xsl:when>
    <xsl:otherwise><xsl:call-template name="mv512"><xsl:with-param name="M" select="$M"/><xsl:with-param name="x" select="$x"/></xsl:call-template></xsl:otherwise>
  </xsl:choose>
</xsl:template>

<!-- exp(x), no EXSLT: range reduction x/128, degree-12 Taylor, 7 squarings. x>40 -> exp(x/2)^2 ; x<-700 -> 0 -->
<xsl:template name="exp"><xsl:param name="x"/>
  <xsl:choose>
    <xsl:when test="$x &lt; -700">0</xsl:when>
    <xsl:when test="$x &gt; 40"><xsl:variable name="h"><xsl:call-template name="exp"><xsl:with-param name="x" select="$x div 2"/></xsl:call-template></xsl:variable><xsl:value-of select="$h*$h"/></xsl:when>
    <xsl:otherwise>
      <xsl:variable name="r" select="$x div 128"/>
      <xsl:variable name="e0" select="1+$r*(1+$r div 2*(1+$r div 3*(1+$r div 4*(1+$r div 5*(1+$r div 6*(1+$r div 7*(1+$r div 8*(1+$r div 9*(1+$r div 10*(1+$r div 11*(1+$r div 12)))))))))))"/>
      <xsl:variable name="e1" select="$e0*$e0"/><xsl:variable name="e2" select="$e1*$e1"/><xsl:variable name="e3" select="$e2*$e2"/>
      <xsl:variable name="e4" select="$e3*$e3"/><xsl:variable name="e5" select="$e4*$e4"/><xsl:variable name="e6" select="$e5*$e5"/><xsl:variable name="e7" select="$e6*$e6"/>
      <xsl:value-of select="$e7"/>
    </xsl:otherwise>
  </xsl:choose>
</xsl:template>

<!-- sqrt(a), a>0: scale into [0.25,4) by factors of 4, then 8 Newton steps from 1 -->
<xsl:template name="sqrt"><xsl:param name="a"/>
  <xsl:choose>
    <xsl:when test="$a &gt;= 4"><xsl:variable name="s"><xsl:call-template name="sqrt"><xsl:with-param name="a" select="$a div 4"/></xsl:call-template></xsl:variable><xsl:value-of select="2*$s"/></xsl:when>
    <xsl:when test="$a &lt; 0.25"><xsl:variable name="s"><xsl:call-template name="sqrt"><xsl:with-param name="a" select="$a * 4"/></xsl:call-template></xsl:variable><xsl:value-of select="$s div 2"/></xsl:when>
    <xsl:otherwise>
      <xsl:variable name="y1" select="($a+1) div 2"/>
      <xsl:variable name="y2" select="($y1+$a div $y1) div 2"/><xsl:variable name="y3" select="($y2+$a div $y2) div 2"/>
      <xsl:variable name="y4" select="($y3+$a div $y3) div 2"/><xsl:variable name="y5" select="($y4+$a div $y4) div 2"/>
      <xsl:variable name="y6" select="($y5+$a div $y5) div 2"/><xsl:variable name="y7" select="($y6+$a div $y6) div 2"/>
      <xsl:variable name="y8" select="($y7+$a div $y7) div 2"/>
      <xsl:value-of select="$y8"/>
    </xsl:otherwise>
  </xsl:choose>
</xsl:template>

<!-- erf (Abramowitz-Stegun 7.1.26, same as qa_infer.py), gelu -->
<xsl:template name="erf"><xsl:param name="x"/>
  <xsl:variable name="ax" select="($x*($x&gt;=0)) - ($x*($x&lt;0))"/>
  <xsl:variable name="t" select="1 div (1+0.3275911*$ax)"/>
  <xsl:variable name="ee"><xsl:call-template name="exp"><xsl:with-param name="x" select="-($ax*$ax)"/></xsl:call-template></xsl:variable>
  <xsl:variable name="y" select="1 - (((((1.061405429*$t - 1.453152027)*$t)+1.421413741)*$t - 0.284496736)*$t+0.254829592)*$t*$ee"/>
  <xsl:choose><xsl:when test="$x &lt; 0"><xsl:value-of select="-$y"/></xsl:when><xsl:otherwise><xsl:value-of select="$y"/></xsl:otherwise></xsl:choose>
</xsl:template>
<xsl:template name="gelu"><xsl:param name="x"/>
  <xsl:variable name="e"><xsl:call-template name="erf"><xsl:with-param name="x" select="$x div 1.41421356"/></xsl:call-template></xsl:variable>
  <xsl:value-of select="0.5*$x*(1+$e)"/>
</xsl:template>
<xsl:template name="gelu-vec"><xsl:param name="x"/>
  <xsl:for-each select="$x"><v><xsl:call-template name="gelu"><xsl:with-param name="x" select="."/></xsl:call-template></v></xsl:for-each>
</xsl:template>
<xsl:template name="relu-vec"><xsl:param name="x"/>
  <xsl:for-each select="$x"><v><xsl:choose><xsl:when test=". &gt; 0"><xsl:value-of select="."/></xsl:when><xsl:otherwise>0</xsl:otherwise></xsl:choose></v></xsl:for-each>
</xsl:template>

<!-- RMSNorm over x (<v> node-set of length n=128) with gain g -->
<xsl:template name="rms"><xsl:param name="x"/><xsl:param name="g"/><xsl:param name="n" select="128"/>
  <xsl:variable name="sqs"><xsl:for-each select="$x"><q><xsl:value-of select=". * ."/></q></xsl:for-each></xsl:variable>
  <xsl:variable name="ss" select="sum(exsl:node-set($sqs)/q)"/>
  <xsl:variable name="sq"><xsl:call-template name="sqrt"><xsl:with-param name="a" select="$ss div $n + 0.00001"/></xsl:call-template></xsl:variable>
  <xsl:variable name="inv" select="1 div $sq"/>
  <xsl:for-each select="$x"><xsl:variable name="i" select="position()"/><v><xsl:value-of select=". * $inv * $g[$i]"/></v></xsl:for-each>
</xsl:template>

<!-- softmax over <v> node-set -->
<xsl:template name="softmax"><xsl:param name="x"/>
  <xsl:variable name="m"><xsl:for-each select="$x"><xsl:sort select="." data-type="number" order="descending"/><xsl:if test="position()=1"><xsl:value-of select="."/></xsl:if></xsl:for-each></xsl:variable>
  <xsl:variable name="ev">
    <xsl:for-each select="$x"><e><xsl:call-template name="exp"><xsl:with-param name="x" select=". - $m"/></xsl:call-template></e></xsl:for-each>
  </xsl:variable>
  <xsl:variable name="es" select="exsl:node-set($ev)/e"/>
  <xsl:variable name="z" select="sum($es)"/>
  <xsl:for-each select="$es"><v><xsl:value-of select=". div $z"/></v></xsl:for-each>
</xsl:template>

<xsl:template name="add"><xsl:param name="a"/><xsl:param name="b"/>
  <xsl:for-each select="$a"><xsl:variable name="i" select="position()"/><v><xsl:value-of select=". + $b[$i]"/></v></xsl:for-each>
</xsl:template>
<!-- attention helpers: per-row weighted V as elements a1..a32, and summation -->
<xsl:template name="wv"><xsl:param name="e"/><xsl:param name="vv"/><z><xsl:value-of select="$e"/></z><a1><xsl:value-of select="$e*$vv[1]"/></a1><a2><xsl:value-of select="$e*$vv[2]"/></a2><a3><xsl:value-of select="$e*$vv[3]"/></a3><a4><xsl:value-of select="$e*$vv[4]"/></a4><a5><xsl:value-of select="$e*$vv[5]"/></a5><a6><xsl:value-of select="$e*$vv[6]"/></a6><a7><xsl:value-of select="$e*$vv[7]"/></a7><a8><xsl:value-of select="$e*$vv[8]"/></a8><a9><xsl:value-of select="$e*$vv[9]"/></a9><a10><xsl:value-of select="$e*$vv[10]"/></a10><a11><xsl:value-of select="$e*$vv[11]"/></a11><a12><xsl:value-of select="$e*$vv[12]"/></a12><a13><xsl:value-of select="$e*$vv[13]"/></a13><a14><xsl:value-of select="$e*$vv[14]"/></a14><a15><xsl:value-of select="$e*$vv[15]"/></a15><a16><xsl:value-of select="$e*$vv[16]"/></a16><a17><xsl:value-of select="$e*$vv[17]"/></a17><a18><xsl:value-of select="$e*$vv[18]"/></a18><a19><xsl:value-of select="$e*$vv[19]"/></a19><a20><xsl:value-of select="$e*$vv[20]"/></a20><a21><xsl:value-of select="$e*$vv[21]"/></a21><a22><xsl:value-of select="$e*$vv[22]"/></a22><a23><xsl:value-of select="$e*$vv[23]"/></a23><a24><xsl:value-of select="$e*$vv[24]"/></a24><a25><xsl:value-of select="$e*$vv[25]"/></a25><a26><xsl:value-of select="$e*$vv[26]"/></a26><a27><xsl:value-of select="$e*$vv[27]"/></a27><a28><xsl:value-of select="$e*$vv[28]"/></a28><a29><xsl:value-of select="$e*$vv[29]"/></a29><a30><xsl:value-of select="$e*$vv[30]"/></a30><a31><xsl:value-of select="$e*$vv[31]"/></a31><a32><xsl:value-of select="$e*$vv[32]"/></a32></xsl:template>
<xsl:template name="wsum"><xsl:param name="p"/><xsl:variable name="z" select="sum($p/z)"/><v><xsl:value-of select="sum($p/a1) div $z"/></v><v><xsl:value-of select="sum($p/a2) div $z"/></v><v><xsl:value-of select="sum($p/a3) div $z"/></v><v><xsl:value-of select="sum($p/a4) div $z"/></v><v><xsl:value-of select="sum($p/a5) div $z"/></v><v><xsl:value-of select="sum($p/a6) div $z"/></v><v><xsl:value-of select="sum($p/a7) div $z"/></v><v><xsl:value-of select="sum($p/a8) div $z"/></v><v><xsl:value-of select="sum($p/a9) div $z"/></v><v><xsl:value-of select="sum($p/a10) div $z"/></v><v><xsl:value-of select="sum($p/a11) div $z"/></v><v><xsl:value-of select="sum($p/a12) div $z"/></v><v><xsl:value-of select="sum($p/a13) div $z"/></v><v><xsl:value-of select="sum($p/a14) div $z"/></v><v><xsl:value-of select="sum($p/a15) div $z"/></v><v><xsl:value-of select="sum($p/a16) div $z"/></v><v><xsl:value-of select="sum($p/a17) div $z"/></v><v><xsl:value-of select="sum($p/a18) div $z"/></v><v><xsl:value-of select="sum($p/a19) div $z"/></v><v><xsl:value-of select="sum($p/a20) div $z"/></v><v><xsl:value-of select="sum($p/a21) div $z"/></v><v><xsl:value-of select="sum($p/a22) div $z"/></v><v><xsl:value-of select="sum($p/a23) div $z"/></v><v><xsl:value-of select="sum($p/a24) div $z"/></v><v><xsl:value-of select="sum($p/a25) div $z"/></v><v><xsl:value-of select="sum($p/a26) div $z"/></v><v><xsl:value-of select="sum($p/a27) div $z"/></v><v><xsl:value-of select="sum($p/a28) div $z"/></v><v><xsl:value-of select="sum($p/a29) div $z"/></v><v><xsl:value-of select="sum($p/a30) div $z"/></v><v><xsl:value-of select="sum($p/a31) div $z"/></v><v><xsl:value-of select="sum($p/a32) div $z"/></v></xsl:template>

<!-- RoPE (interleaved pairs, head dim 32) on a 128-vector; cs = 32 <v>: 16 cos then 16 sin for this position -->
<xsl:template name="rope"><xsl:param name="x"/><xsl:param name="cs"/>
  <xsl:for-each select="$x[position() mod 2 = 1]"><xsl:variable name="j" select="(position()-1) mod 16"/>
    <xsl:variable name="c" select="$cs[$j+1]"/><xsl:variable name="s" select="$cs[$j+17]"/><xsl:variable name="b" select="following-sibling::v[1]"/>
    <v><xsl:value-of select=". * $c - $b * $s"/></v><v><xsl:value-of select=". * $s + $b * $c"/></v>
  </xsl:for-each>
</xsl:template>
</xsl:stylesheet>
